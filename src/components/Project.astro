---
import type { Project } from "../shared/constants";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

// Superscript glyph for cross-referencing the sidenote (¹, ², ...).
const SUPERSCRIPTS = ["¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"];
const ref = SUPERSCRIPTS[index] ?? `[${index + 1}]`;
---

<article class="project">
  <div class="body">
    <div class="row">
      <span class="name">
        {project.href
          ? <a href={project.href} target="_blank" rel="noopener">{project.name}</a>
          : project.name}
      </span>
      <span class="date">{project.date}</span>
    </div>
    <p class="summary">
      {project.summary}<sup class="ref">{ref}</sup>
    </p>
  </div>
  <aside class="marg" aria-label={`Note ${index + 1} on ${project.name}`}>
    <span class="marg-num">{index + 1}</span>{project.sidenote}
  </aside>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--hairline);
  }
  .project:first-of-type {
    border-top: none;
  }
  .body {
    padding-right: 0.5rem;
    max-width: 56ch;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .name {
    font-weight: 700;
    font-size: 1.1rem;
  }
  .name a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--underline);
  }
  .date {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    color: var(--textLabel);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .summary {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .ref {
    color: var(--textMuted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    margin-left: 0.15rem;
    text-decoration: none;
  }
  .marg {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--textMuted);
    border-left: 2px solid var(--underline);
    padding-left: 1rem;
    font-style: italic;
    max-width: 30ch;
  }
  .marg-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    color: var(--textLabel);
    margin-right: 0.4rem;
    vertical-align: super;
    font-style: normal;
  }

  /* Mobile: collapse to single column. Sidenote renders inline below summary. */
  @media (max-width: 720px) {
    .project {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .body {
      padding-right: 0;
      max-width: 100%;
    }
    .marg {
      max-width: 100%;
    }
  }
</style>
